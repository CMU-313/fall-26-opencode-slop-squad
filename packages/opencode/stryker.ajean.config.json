{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun --cwd packages/opencode test --timeout 30000 test/session/compaction.property.test.ts --only-failures"
  },
  "mutate": ["packages/core/src/session/compaction.ts:161-187"],
  "coverageAnalysis": "off",
  "inPlace": true,
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 3,
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "packages/opencode/reports/ajean/mutation.html" },
  "jsonReporter": { "fileName": "packages/opencode/reports/ajean/mutation.json" },
  "tempDirName": "packages/opencode/.stryker-tmp/ajean",
  "ignorePatterns": [
    "**/reports/**",
    "**/.stryker-tmp/**",
    "mutants/**",
    "packages/console/**",
    "packages/mail/**",
    "packages/desktop/**",
    "packages/stats/**",
    "artifacts/**",
    "perf/**"
  ],
  "thresholds": { "high": 80, "low": 60, "break": 0 }
}
