{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun --cwd packages/opencode test --timeout 30000 test/session/sihengxia-compaction.property.test.ts --only-failures"
  },
  "mutate": [
    "packages/core/src/session/compaction.ts:16-46",
    "packages/core/src/session/compaction.ts:161-186",
    "packages/tui/src/util/compaction.ts:20-63"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "dryRunTimeoutMinutes": 3,
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "packages/opencode/reports/sihengxia/mutation.html" },
  "jsonReporter": { "fileName": "packages/opencode/reports/sihengxia/mutation.json" },
  "tempDirName": "packages/opencode/.stryker-tmp/sihengxia",
  "ignorePatterns": ["**/reports/**", "**/.stryker-tmp/**", "mutants/**"],
  "thresholds": { "high": 80, "low": 60, "break": 0 }
}
